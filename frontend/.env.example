REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
# Local Flask (default for development):
REACT_APP_API_URL=http://localhost:5001
# Production (Vercel build): https://fra-gis.onrender.com

# Google Maps JavaScript API key (required for WebGIS)
# Enable "Maps JavaScript API" in Google Cloud Console.
REACT_APP_GOOGLE_MAPS_API_KEY=
# Optional Cloud Map ID for Advanced Markers (defaults to DEMO_MAP_ID)
# REACT_APP_GOOGLE_MAPS_MAP_ID=
